{
  "manifest_version": 3,
  "name": "OLAT Auto-Login",
  "version": "1.0.0",
  "description": "Meldet dich auf olat.bms-w.ch automatisch an und hält die Sitzung am Leben.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "cookies", "alarms"],
  "host_permissions": ["https://olat.bms-w.ch/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://olat.bms-w.ch/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OLAT Auto-Login",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
