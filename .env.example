# OpenOLAT-Instanz
OLAT_BASE_URL=https://olat.bms-w.ch

# Für "stdio" und "npm run smoke": eigene Zugangsdaten (alternativ: `openolat-mcp-api login`)
OLAT_USERNAME=
OLAT_PASSWORD=

# HTTP-Server ("serve")
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Öffentliche URL, falls hinter Reverse Proxy (für die Setup-Seite)
PUBLIC_URL=
# Token-Store: file (Standard, data/) oder stateless (Standard auf Vercel)
STORE=
# Server-Secret. Pflicht bei stateless/Vercel (mind. 32 Zeichen, z.B. openssl rand -base64 48), sonst wird data/server.key erzeugt.
# Echten Wert nie einchecken; auf Vercel: vercel env add OLAT_MCP_SECRET production --sensitive
OLAT_MCP_SECRET=

# Hosts, deren eingebettete Landing Pages gelesen werden dürfen (kommagetrennt, nur GET/https). Leer = abgeschaltet.
OLAT_EXTERNAL_HOSTS=landingpage.bmsw-server.ch

MAX_DOWNLOAD_MB=30
MAX_INLINE_MB=4
