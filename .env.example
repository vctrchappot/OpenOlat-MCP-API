# OpenOLAT-Instanz
OLAT_BASE_URL=https://olat.bms-w.ch

# Für "stdio" und "npm run smoke": eigene Zugangsdaten (alternativ: `openolat-mcp-api login`)
OLAT_USERNAME=
OLAT_PASSWORD=

# HTTP-Server ("serve")
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Öffentliche URL, falls hinter Reverse Proxy (für die Setup-Seite)
PUBLIC_URL=
# Optional: Server-Secret (sonst wird data/server.key erzeugt)
OLAT_MCP_SECRET=

MAX_DOWNLOAD_MB=30
MAX_INLINE_MB=4
